# All keys are optional - price, signal, scanner, heatmap, sentiment and portfolio tools work without any.

# NSE options chain (get_options_chain, detect_unusual_activity)
# Free: https://account.upstox.com/developer/apps  (daily access token, or long-lived Analytics Token)
UPSTOX_ACCESS_TOKEN=

# Fallback news source only (primary is Google News RSS, no key needed)
# Free key: https://newsapi.org/register
NEWSAPI_KEY=

RISK_FREE_RATE=0.065

# Optional
# PORT=3000
# DB_PATH=./data/portfolio.db

# Used only by `npm run upstox-login` to refresh UPSTOX_ACCESS_TOKEN daily
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback
